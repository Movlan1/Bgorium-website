DirectoryIndex index.php

<IfModule mod_rewrite.c>
	RewriteEngine On
	##### Multi-Language
	RewriteRule ^([a-z]{2})(/?)$ index.php?lang=$1 [L]

	RewriteRule ^([a-z]{2})/page/([0-9]+)(/?)$ index.php?cstart=$2&lang=$1 [L]

	RewriteRule ^([a-z]{2})/([0-9]{4})/([0-9]{2})/([0-9]{2})/page,([0-9]+),([0-9]+),(.*).html$ index.php?subaction=showfull&year=$2&month=$3&day=$4&news_page=$5&cstart=$6&news_name=$7&seourl=$7&lang=$1 [L]
	RewriteRule ^([a-z]{2})/([0-9]{4})/([0-9]{2})/([0-9]{2})/page,([0-9]+),(.*).html$ index.php?subaction=showfull&year=$2&month=$3&day=$4&news_page=$5&news_name=$6&seourl=$6&lang=$1 [L]
	RewriteRule ^([a-z]{2})/([0-9]{4})/([0-9]{2})/([0-9]{2})/print:page,([0-9]+),(.*).html$ index.php?mod=print&subaction=showfull&year=$2&month=$3&day=$4&news_page=$5&news_name=$6&seourl=$6&lang=$1 [L]
	RewriteRule ^([a-z]{2})/([0-9]{4})/([0-9]{2})/([0-9]{2})/(.*).html$ index.php?subaction=showfull&year=$2&month=$3&day=$4&news_name=$5&seourl=$5&lang=$1 [L]

	RewriteRule ^([a-z]{2})/([^.]+)/page,([0-9]+),([0-9]+),([0-9]+)-(.*).html$ index.php?newsid=$5&news_page=$3&cstart=$4&seourl=$6&seocat=$2&lang=$1 [L]
	RewriteRule ^([a-z]{2})/([^.]+)/page,([0-9]+),([0-9]+)-(.*).html$ index.php?newsid=$4&news_page=$3&seourl=$5&seocat=$2&lang=$1 [L]
	RewriteRule ^([a-z]{2})/([^.]+)/print:page,([0-9]+),([0-9]+)-(.*).html$ index.php?mod=print&news_page=$3&newsid=$4&seourl=$5&seocat=$2&lang=$1 [L]
	RewriteRule ^([a-z]{2})/([^.]+)/([0-9]+)-(.*).html$ index.php?newsid=$3&seourl=$4&seocat=$2&lang=$1 [L]

	RewriteRule ^([a-z]{2})/page,([0-9]+),([0-9]+),([0-9]+)-(.*).html$ index.php?newsid=$4&news_page=$2&cstart=$3&seourl=$5&lang=$1 [L]
	RewriteRule ^([a-z]{2})/page,([0-9]+),([0-9]+)-(.*).html$ index.php?newsid=$3&news_page=$2&seourl=$4&lang=$1 [L]
	RewriteRule ^([a-z]{2})/print:page,([0-9]+),([0-9]+)-(.*).html$ index.php?mod=print&news_page=$2&newsid=$3&seourl=$4&lang=$1 [L]
	RewriteRule ^([a-z]{2})/([0-9]+)-(.*).html$ index.php?newsid=$2&seourl=$3&lang=$1 [L]

	RewriteRule ^([a-z]{2})/([0-9]{4})/([0-9]{2})/([0-9]{2})(/?)+$ index.php?year=$2&month=$3&day=$4&lang=$1 [L]
	RewriteRule ^([a-z]{2})/([0-9]{4})/([0-9]{2})/([0-9]{2})/page/([0-9]+)(/?)+$ index.php?year=$2&month=$3&day=$4&cstart=$5&lang=$1 [L]

	RewriteRule ^([a-z]{2})/([0-9]{4})/([0-9]{2})(/?)+$ index.php?year=$2&month=$3&lang=$1 [L]
	RewriteRule ^([a-z]{2})/([0-9]{4})/([0-9]{2})/page/([0-9]+)(/?)+$ index.php?year=$2&month=$3&cstart=$4&lang=$1 [L]

	RewriteRule ^([a-z]{2})/([0-9]{4})(/?)+$ index.php?year=$2&lang=$1 [L]
	RewriteRule ^([a-z]{2})/([0-9]{4})/page/([0-9]+)(/?)+$ index.php?year=$2&cstart=$3&lang=$1 [L]

	RewriteRule ^([a-z]{2})/tags/([^/]*)(/?)+$ index.php?do=tags&tag=$2&lang=$1 [B,L]
	RewriteRule ^([a-z]{2})/tags/([^/]*)/page/([0-9]+)(/?)+$ index.php?do=tags&tag=$2&cstart=$3&lang=$1 [B,L]

	RewriteRule ^([a-z]{2})/xfsearch/(.*)/page/([0-9]+)(/?)+$ index.php?do=xfsearch&xf=$2&cstart=$3&lang=$1 [B,L]
	RewriteRule ^([a-z]{2})/xfsearch/(.*)/?$ index.php?do=xfsearch&xf=$2&lang=$1 [B,L]

	RewriteRule ^([a-z]{2})/user/([^/]*)/rss.xml$ index.php?mod=rss&subaction=allnews&user=$2&lang=$1 [B,L]
	RewriteRule ^([a-z]{2})/user/([^/]*)/rssdzen.xml$ index.php?mod=rss&subaction=allnews&rssmode=dzen&user=$2&lang=$1 [B,L]
	RewriteRule ^([a-z]{2})/user/([^/]*)(/?)+$ index.php?subaction=userinfo&user=$2&lang=$1 [B,L]
	RewriteRule ^([a-z]{2})/user/([^/]*)/page/([0-9]+)(/?)+$ index.php?subaction=userinfo&user=$2&cstart=$3&lang=$1 [B,L]
	RewriteRule ^([a-z]{2})/user/([^/]*)/news(/?)+$ index.php?subaction=allnews&user=$2&lang=$1 [B,L]
	RewriteRule ^([a-z]{2})/user/([^/]*)/news/page/([0-9]+)(/?)+$ index.php?subaction=allnews&user=$2&cstart=$3&lang=$1 [B,L]

	RewriteRule ^([a-z]{2})/lastnews(/?)+$ index.php?do=lastnews&lang=$1 [L]
	RewriteRule ^([a-z]{2})/lastnews/page/([0-9]+)(/?)+$ index.php?do=lastnews&cstart=$2&lang=$1 [L]

	RewriteRule ^([a-z]{2})/catalog/([^/]*)/rss.xml$ engine/rss.php?catalog=$2&lang=$1 [L]
	RewriteRule ^([a-z]{2})/catalog/([^/]*)/rssdzen.xml$ index.php?mod=rss&rssmode=dzen&catalog=$2&lang=$1 [L]
	RewriteRule ^([a-z]{2})/catalog/([^/]*)(/?)+$ index.php?catalog=$2&lang=$1 [L]
	RewriteRule ^([a-z]{2})/catalog/([^/]*)/page/([0-9]+)(/?)+$ index.php?catalog=$2&cstart=$3&lang=$1 [L]

	RewriteRule ^([a-z]{2})/newposts(/?)+$ index.php?subaction=newposts&lang=$1 [L]
	RewriteRule ^([a-z]{2})/newposts/page/([0-9]+)(/?)+$ index.php?subaction=newposts&cstart=$2&lang=$1 [L]

	RewriteRule ^([a-z]{2})/favorites(/?)+$ index.php?do=favorites&lang=$1 [L]
	RewriteRule ^([a-z]{2})/favorites/page/([0-9]+)(/?)+$ index.php?do=favorites&cstart=$2&lang=$1 [L]

	RewriteRule ^([a-z]{2})/rules.html$ index.php?do=rules&lang=$1 [L]
	RewriteRule ^([a-z]{2})/statistics.html$ index.php?do=stats&lang=$1 [L]
	RewriteRule ^([a-z]{2})/addnews.html$ index.php?do=addnews&lang=$1 [L]
	RewriteRule ^([a-z]{2})/rss.xml$ index.php?mod=rss&lang=$1 [L]
	RewriteRule ^([a-z]{2})/rssdzen.xml$ index.php?mod=rss&rssmode=dzen&lang=$1 [L]
	RewriteRule ^([a-z]{2})/sitemap.xml$ uploads/sitemap_$1.xml [L]
	RewriteRule ^([a-z]{2})/google_news.xml$ uploads/google_news_$1.xml [L]

	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteRule ^([a-z]{2})/([^.]+)/page/([0-9]+)(/?)+$ index.php?do=cat&category=$2&cstart=$3&lang=$1 [L]
	RewriteRule ^([a-z]{2})/([^.]+)/?$ index.php?do=cat&category=$2&lang=$1 [L]

	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteRule ^([a-z]{2})/([^.]+)/rss.xml$ index.php?mod=rss&do=cat&category=$2&lang=$1 [L]
	RewriteRule ^([a-z]{2})/([^.]+)/rssdzen.xml$ index.php?mod=rss&do=cat&rssmode=dzen&category=$2&lang=$1 [L]
	RewriteRule ^([a-z]{2})/page,([0-9]+),([^/]+).html$ index.php?do=static&page=$3&news_page=$2&seourl=$3&lang=$1 [L]
	RewriteRule ^([a-z]{2})/print:([^/]+).html$ index.php?mod=print&do=static&page=$2&seourl=$2&lang=$1 [L]

	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteRule ^([a-z]{2})/([^/]+).html$ index.php?do=static&page=$2&seourl=$2&lang=$1 [L]
	##### Multi-Language

	RewriteRule ^page/([0-9]+)(/?)$ index.php?cstart=$1 [L]

	RewriteRule ^([0-9]{4})/([0-9]{2})/([0-9]{2})/page,([0-9]+),([0-9]+),(.*).html$ index.php?subaction=showfull&year=$1&month=$2&day=$3&news_page=$4&cstart=$5&news_name=$6&seourl=$6 [L]
	RewriteRule ^([0-9]{4})/([0-9]{2})/([0-9]{2})/page,([0-9]+),(.*).html$ index.php?subaction=showfull&year=$1&month=$2&day=$3&news_page=$4&news_name=$5&seourl=$5 [L]
	RewriteRule ^([0-9]{4})/([0-9]{2})/([0-9]{2})/print:page,([0-9]+),(.*).html$ index.php?mod=print&subaction=showfull&year=$1&month=$2&day=$3&news_page=$4&news_name=$5&seourl=$5 [L]
	RewriteRule ^([0-9]{4})/([0-9]{2})/([0-9]{2})/(.*).html$ index.php?subaction=showfull&year=$1&month=$2&day=$3&news_name=$4&seourl=$4 [L]

	RewriteRule ^([^.]+)/page,([0-9]+),([0-9]+),([0-9]+)-(.*).html$ index.php?newsid=$4&news_page=$2&cstart=$3&seourl=$5&seocat=$1 [L]
	RewriteRule ^([^.]+)/page,([0-9]+),([0-9]+)-(.*).html$ index.php?newsid=$3&news_page=$2&seourl=$4&seocat=$1 [L]
	RewriteRule ^([^.]+)/print:page,([0-9]+),([0-9]+)-(.*).html$ index.php?mod=print&news_page=$2&newsid=$3&seourl=$4&seocat=$1 [L]
	RewriteRule ^([^.]+)/([0-9]+)-(.*).html$ index.php?newsid=$2&seourl=$3&seocat=$1 [L]

	RewriteRule ^page,([0-9]+),([0-9]+),([0-9]+)-(.*).html$ index.php?newsid=$3&news_page=$1&cstart=$2&seourl=$4 [L]
	RewriteRule ^page,([0-9]+),([0-9]+)-(.*).html$ index.php?newsid=$2&news_page=$1&seourl=$3 [L]
	RewriteRule ^print:page,([0-9]+),([0-9]+)-(.*).html$ index.php?mod=print&news_page=$1&newsid=$2&seourl=$3 [L]
	RewriteRule ^([0-9]+)-(.*).html$ index.php?newsid=$1&seourl=$2 [L]

	RewriteRule ^([0-9]{4})/([0-9]{2})/([0-9]{2})(/?)+$ index.php?year=$1&month=$2&day=$3 [L]
	RewriteRule ^([0-9]{4})/([0-9]{2})/([0-9]{2})/page/([0-9]+)(/?)+$ index.php?year=$1&month=$2&day=$3&cstart=$4 [L]

	RewriteRule ^([0-9]{4})/([0-9]{2})(/?)+$ index.php?year=$1&month=$2 [L]
	RewriteRule ^([0-9]{4})/([0-9]{2})/page/([0-9]+)(/?)+$ index.php?year=$1&month=$2&cstart=$3 [L]

	RewriteRule ^([0-9]{4})(/?)+$ index.php?year=$1 [L]
	RewriteRule ^([0-9]{4})/page/([0-9]+)(/?)+$ index.php?year=$1&cstart=$2 [L]

	RewriteRule ^tags/([^/]*)(/?)+$ index.php?do=tags&tag=$1 [B,L]
	RewriteRule ^tags/([^/]*)/page/([0-9]+)(/?)+$ index.php?do=tags&tag=$1&cstart=$2 [B,L]

	RewriteRule ^xfsearch/(.*)/page/([0-9]+)(/?)+$ index.php?do=xfsearch&xf=$1&cstart=$2 [B,L]
	RewriteRule ^xfsearch/(.*)/?$ index.php?do=xfsearch&xf=$1 [B,L]

	RewriteRule ^user/([^/]*)/rss.xml$ index.php?mod=rss&subaction=allnews&user=$1 [B,L]
	RewriteRule ^user/([^/]*)/rssdzen.xml$ index.php?mod=rss&subaction=allnews&rssmode=dzen&user=$1 [B,L]
	RewriteRule ^user/([^/]*)(/?)+$ index.php?subaction=userinfo&user=$1 [B,L]
	RewriteRule ^user/([^/]*)/page/([0-9]+)(/?)+$ index.php?subaction=userinfo&user=$1&cstart=$2 [B,L]
	RewriteRule ^user/([^/]*)/news(/?)+$ index.php?subaction=allnews&user=$1 [B,L]
	RewriteRule ^user/([^/]*)/news/page/([0-9]+)(/?)+$ index.php?subaction=allnews&user=$1&cstart=$2 [B,L]

	RewriteRule ^lastnews(/?)+$ index.php?do=lastnews [L]
	RewriteRule ^lastnews/page/([0-9]+)(/?)+$ index.php?do=lastnews&cstart=$1 [L]

	RewriteRule ^catalog/([^/]*)/rss.xml$ index.php?mod=rss&catalog=$1 [L]
	RewriteRule ^catalog/([^/]*)/rssdzen.xml$ index.php?mod=rss&rssmode=dzen&catalog=$1 [L]
	RewriteRule ^catalog/([^/]*)(/?)+$ index.php?catalog=$1 [L]
	RewriteRule ^catalog/([^/]*)/page/([0-9]+)(/?)+$ index.php?catalog=$1&cstart=$2 [L]

	RewriteRule ^newposts(/?)+$ index.php?subaction=newposts [L]
	RewriteRule ^newposts/page/([0-9]+)(/?)+$ index.php?subaction=newposts&cstart=$1 [L]

	RewriteRule ^favorites(/?)+$ index.php?do=favorites [L]
	RewriteRule ^favorites/page/([0-9]+)(/?)+$ index.php?do=favorites&cstart=$1 [L]

	RewriteRule ^rules.html$ index.php?do=rules [L]
	RewriteRule ^statistics.html$ index.php?do=stats [L]
	RewriteRule ^addnews.html$ index.php?do=addnews [L]
	RewriteRule ^rss.xml$ index.php?mod=rss [L]
	RewriteRule ^rssdzen.xml$ index.php?mod=rss&rssmode=dzen [L]
	RewriteRule ^sitemap.xml$ uploads/sitemap.xml [L]
	RewriteRule ^google_news.xml$ uploads/google_news.xml [L]
	RewriteRule ^static_pages.xml$ uploads/static_pages.xml [L]
	RewriteRule ^category_pages.xml$ uploads/category_pages.xml [L]
	RewriteRule ^tags_pages.xml$ uploads/tags_pages.xml [L]
	RewriteRule ^news_pages(\d*?).xml$ uploads/news_pages$1.xml [L]

	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteRule ^([^.]+)/page/([0-9]+)(/?)+$ index.php?do=cat&category=$1&cstart=$2 [L]
	RewriteRule ^([^.]+)/?$ index.php?do=cat&category=$1 [L]

	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteRule ^([^.]+)/rss.xml$ index.php?mod=rss&do=cat&category=$1 [L]
	RewriteRule ^([^.]+)/rssdzen.xml$ index.php?mod=rss&do=cat&rssmode=dzen&category=$1 [L]
	RewriteRule ^page,([0-9]+),([^/]+).html$ index.php?do=static&page=$2&news_page=$1&seourl=$2 [L]
	RewriteRule ^print:([^/]+).html$ index.php?mod=print&do=static&page=$1&seourl=$1 [L]

	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteRule ^([^/]+).html$ index.php?do=static&page=$1&seourl=$1 [L]
</IfModule>